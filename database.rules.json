{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name', 'email']) && newData.child('uid').val() === $uid)",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "image": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
        },
        "userType": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
        },
        "bio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "studyStatusPublic": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "communityActivityPublic": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "color": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)"
        },
        "createdAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now)"
        },
        "updatedAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
        },
        "privacyPolicyAgreedAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "image": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
        },
        "userType": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
        },
        "bio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "color": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)"
        },
        "studyStatusPublic": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "communityActivityPublic": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('rooms').child($roomId).child('deputy1Id').val() === auth.uid || root.child('rooms').child($roomId).child('deputy2Id').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "visibility"
      ],
      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('ownerId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('ownerId').val() === auth.uid) || (data.exists() && newData.exists() && data.child('ownerId').val() === auth.uid && (newData.child('ownerId').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(newData.child('ownerId').val()).exists() && newData.child('members').child(newData.child('ownerId').val()).exists()))))",
        ".validate": "!newData.exists() || data.exists() || newData.hasChildren(['ownerId', 'name', 'subjects', 'emoji', 'color', 'max', 'code', 'visibility', 'createdAt'])",
        "ownerId": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()) || (data.exists() && data.val() === auth.uid && root.child('rooms').child($roomId).child('members').child(newData.val()).exists()))"
        },
        "deputy1Id": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val() !== root.child('rooms').child($roomId).child('ownerId').val() && newData.val() !== newData.parent().child('deputy2Id').val() && root.child('rooms').child($roomId).child('members').child(newData.val()).exists())"
        },
        "deputy2Id": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val() !== root.child('rooms').child($roomId).child('ownerId').val() && newData.val() !== newData.parent().child('deputy1Id').val() && root.child('rooms').child($roomId).child('members').child(newData.val()).exists())"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "subjects": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "emoji": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "max": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 20"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length === 6"
        },
        "visibility": {
          ".validate": "newData.isString() && (newData.val() === 'public' || newData.val() === 'private')"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "mode": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms').child($roomId).exists() && (data.exists() || root.child('rooms').child($roomId).child('visibility').val() === 'public')) || ((root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('rooms').child($roomId).child('deputy1Id').val() === auth.uid || root.child('rooms').child($roomId).child('deputy2Id').val() === auth.uid) && !data.exists() && newData.exists() && root.child('roomJoinRequests').child($roomId).child($uid).child('status').val() === 'pending'))",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'color', 'online', 'lastSeenAt', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "image": {
              ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
            },
            "userType": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
            },
            "bio": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
            },
            "studyStatusPublic": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "speaking": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "status": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
            },
            "studyStartEpoch": {
              ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
            },
            "isStudying": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "goalSeconds": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 60 && newData.val() <= 86400)"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeenAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.isString() && $code.length === 6 && root.child('rooms').child(newData.val()).child('ownerId').val() === auth.uid) || (data.exists() && !newData.exists() && (!root.child('rooms').child(data.val()).exists() || root.child('rooms').child(data.val()).child('ownerId').val() === auth.uid)) || (data.exists() && newData.exists() && newData.isString() && $code.length === 6 && root.child('rooms').child(data.val()).child('ownerId').val() === auth.uid && root.child('rooms').child(newData.val()).child('ownerId').val() === auth.uid))",
        ".validate": "!newData.exists() || newData.isString()"
      }
    },
    "communityPosts": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "category",
        "authorId"
      ],
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid) || (data.exists() && newData.exists() && data.child('authorId').val() === auth.uid && newData.child('authorId').val() === auth.uid))",
        ".validate": "!newData.exists() || newData.hasChildren(['authorId', 'author', 'category', 'title', 'body', 'createdAt'])",
        "authorId": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "authorType": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
        },
        "authorImage": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
        },
        "authorBio": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "category": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 30)"
        },
        "groupCode": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length === 6)"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 2000"
        },
        "image": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        },
        "cheerCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "commentCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityPostCheers": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && !newData.exists() && (!data.exists() || root.child('communityPosts').child($postId).child('authorId').val() === auth.uid)",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('communityPosts').child($postId).exists())) || (data.exists() && !newData.exists() && root.child('communityPosts').child($postId).child('authorId').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.val() === true || (newData.hasChildren(['authorId', 'createdAt']) && newData.child('authorId').val() === $uid)",
          "authorId": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "communityPostComments": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && !newData.exists() && (!data.exists() || root.child('communityPosts').child($postId).child('authorId').val() === auth.uid)",
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('communityPosts').child($postId).exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('authorId').val() === auth.uid || root.child('communityPosts').child($postId).child('authorId').val() === auth.uid)) || (data.exists() && newData.exists() && root.child('communityPosts').child($postId).exists() && data.child('authorId').val() === auth.uid && newData.child('authorId').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.hasChildren(['authorId', 'author', 'body', 'createdAt'])",
          "authorId": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
          },
          "author": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "authorImage": {
            ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "blockedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockedUid": {
          ".write": "auth != null && auth.uid === $uid && $blockedUid !== $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name', 'createdAt']) && newData.child('uid').val() === $blockedUid)",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $blockedUid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "image": {
            ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "roomAnnouncements": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('rooms').child($roomId).child('deputy1Id').val() === auth.uid || root.child('rooms').child($roomId).child('deputy2Id').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['text', 'authorId', 'authorName', 'updatedAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "authorId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomJoinRequests": {
      "$roomId": {
        ".read": "auth != null && (root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('rooms').child($roomId).child('deputy1Id').val() === auth.uid || root.child('rooms').child($roomId).child('deputy2Id').val() === auth.uid)",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((auth.uid === $uid && newData.child('applicantId').val() === $uid && newData.child('status').val() === 'pending' && root.child('rooms').child($roomId).child('visibility').val() === 'private' && !root.child('rooms').child($roomId).child('members').child($uid).exists() && (!data.exists() || data.child('status').val() !== 'pending')) || ((root.child('rooms').child($roomId).child('ownerId').val() === auth.uid || root.child('rooms').child($roomId).child('deputy1Id').val() === auth.uid || root.child('rooms').child($roomId).child('deputy2Id').val() === auth.uid) && data.child('status').val() === 'pending' && newData.child('applicantId').val() === $uid && (newData.child('status').val() === 'approved' || newData.child('status').val() === 'rejected'))) ",
          ".validate": "!newData.exists() || newData.hasChildren(['applicantId', 'name', 'color', 'requestedAt', 'status'])",
          "applicantId": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "image": {
            ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 700000)"
          },
          "userType": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
          },
          "bio": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
          },
          "requestedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')"
          },
          "reviewedBy": {
            ".validate": "!newData.exists() || (newData.isString() && (root.child('rooms').child($roomId).child('ownerId').val() === newData.val() || root.child('rooms').child($roomId).child('deputy1Id').val() === newData.val() || root.child('rooms').child($roomId).child('deputy2Id').val() === newData.val()))"
          },
          "reviewedAt": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "userReports": {
      "$reporterUid": {
        ".read": false,
        "$reportId": {
          ".write": "auth != null && auth.uid === $reporterUid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['reporterId', 'targetUid', 'targetType', 'reason', 'createdAt']) && newData.child('reporterId').val() === $reporterUid && newData.child('targetUid').val() !== $reporterUid",
          "reporterId": {
            ".validate": "newData.isString() && newData.val() === $reporterUid"
          },
          "targetUid": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
          },
          "targetType": {
            ".validate": "newData.isString() && (newData.val() === 'user' || newData.val() === 'post' || newData.val() === 'comment')"
          },
          "targetId": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
          },
          "reason": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
